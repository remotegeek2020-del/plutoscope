# Plutoscope environment variables — copy to `.env.local` for local dev.
# NEVER commit real values. Production/preview secrets live in the Vercel and Supabase
# environment-variable stores (Part VIII §43). NEXT_PUBLIC_* are exposed to the browser
# (safe: the anon/publishable key is protected by Row Level Security). Everything else is
# server-only and must never be prefixed NEXT_PUBLIC_.

# --- Supabase (per environment: dev vs staging vs prod) ---
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="sb_publishable_xxx"        # publishable/anon key (client-safe)
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"         # SERVER ONLY — bypasses RLS. Used for
                                                          # the staff-impersonation flow (§18.1).

# --- AI engine API keys (server-only) — used from Milestone 1 onward (§19) ---
OPENAI_API_KEY=""        # OpenAI Responses API + web_search tool (ChatGPT citations)
PERPLEXITY_API_KEY=""    # Perplexity Sonar API
GEMINI_API_KEY=""        # Gemini API — Google Search grounding
# Optional model overrides (generations advance — set current cost-effective models at deploy):
OPENAI_MODEL=""          # default: gpt-4o
GEMINI_MODEL=""          # default: gemini-2.5-flash

# --- OpenRouter (CONTENT/brief generation only — not visibility tracking) ---
# One key, many models. When set, briefs prefer OpenRouter over OPENAI/GEMINI. Tracking still uses
# the three web-grounded engines above (OpenRouter models don't browse/return citations).
OPENROUTER_API_KEY=""    # https://openrouter.ai — server-only
OPENROUTER_MODEL=""      # e.g. anthropic/claude-3.5-sonnet; default: openai/gpt-4o-mini

# --- Vendors (approved) ---
FIRECRAWL_API_KEY=""     # Page-crawling API for the audit engine (Milestone 3 / Week 11)
STRIPE_SECRET_KEY=""     # Payments (Milestone 5 / Week 19)
STRIPE_WEBHOOK_SECRET="" # from `stripe listen` / the Stripe dashboard webhook
STRIPE_PRICE_STARTER=""  # Stripe Price ID for the Starter plan
STRIPE_PRICE_CONSULTANT="" # Stripe Price ID for the Consultant plan
NEXT_PUBLIC_APP_URL=""   # e.g. https://app.plutoscope.com — used for Stripe redirect URLs

# --- Scheduler ---
# Vercel Cron presents this as a Bearer token to the internal tracking processor route.
# Set the same value in Vercel's env; Vercel auto-sends it on cron invocations.
CRON_SECRET=""

# --- White-label PDF export (Milestone 4 / Week 17) ---
# Path to a headless Chromium binary for server-side HTML->PDF. On Vercel serverless, point this
# at an @sparticuz/chromium binary; locally, at your installed Chromium. If unset, playwright-core
# tries its bundled browser.
CHROMIUM_EXECUTABLE_PATH=""

# --- Error monitoring (Sentry) ---
NEXT_PUBLIC_SENTRY_DSN=""  # runtime error capture is off until this is set
SENTRY_ORG=""              # build-time source-map upload (optional until provisioned)
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""
